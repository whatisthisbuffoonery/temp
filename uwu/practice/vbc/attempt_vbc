#include <stdio.h>
#include <malloc.h>
#include <ctype.h>

typedef struct node {
	enum {
		ADD,
		MULTI,
		VAL
	}			type;
	int			val;
	struct node	*l;
	struct node	*r;
}	node;

typedef enum
{
	OP,
	NUM
}	t_wait;

node		*parse_expr(char **s, int bracket);

node		*new_node(node n)
{
	node	*ret = calloc(1, sizeof(node));
	if (!ret)
		return (NULL);
	*ret = n;
	return (ret);
}

void		destroy_tree(node *n)
{
	if (!n)
		return ;
	if (n->type != VAL)
	{
		destroy_tree(n->l);
		destroy_tree(n->r);
	}
	free(n);
}

void		unexpected(char c)
{
	static int	flag;

	if (flag)
		return ;
	flag ++;
	if (c)
		printf("Unexpected token '%c'\n", c);
	else
		printf("Unexpected end of input\n");
}

int	accept(char **s, char c)
{
	if (**s == c)
		return (((*s)++), 1);
	return (0);
}

void	reparent_l(node **l, node *curr)
{
	curr->l = *l;
	*l = curr;
}

//boilerplate above

node	*append_node(char **s, t_wait wait)
{
	node	tmp;
	int		wasdigit = isdigit(**s);

	tmp.l = NULL;
	tmp.r = NULL;
	tmp.val = 0;
//	printf("process %c\n", **s);
	if ((wasdigit && wait != NUM) || (!wasdigit && wait != OP))//no brackets
		return (NULL);
	if (wasdigit)
	{
		tmp.type = VAL;
		tmp.val = **s - '0';
	}
	else if (**s == '+')
		tmp.type = ADD;
	else if (**s == '*')
		tmp.type = MULTI;
	else
		return (NULL);//main loop covers msg
//		return ((printf("append err: ")), (unexpected(**s)), NULL);
	node	*ret = new_node(tmp);
	if (ret)
		(*s)++;
	return (ret);
}

//curr not null
int	increment(node **l, t_wait *wait, node *curr, char **s)
{
	if (!*l)
		*l = curr;
	else if ((*l)->type == VAL)//handles (2) + ...
		reparent_l(l, curr);
	else if (!(*l)->r)//what the fuck this handles brackets already
		(*l)->r = curr;
	else if ((*l)->type == ADD && curr->type == MULTI)//cant have bracket with NUM wait
	{
		curr->l = (*l)->r;
		(*l)->r = curr;
		if (accept(s, '('))//consume the damn bracket
			curr->r = parse_expr(s, 1);
		else
			curr->r = append_node(s, NUM);
		*wait = !*wait;//compensation
		return (!curr->r);
	}
	else
		reparent_l(l, curr);
	return (0);
}

int	check_wait(t_wait wait, char c, int bracket)
{
	int	wasnum = (isdigit(c) || c == '(');
	int	wasop = (c == '+' || c == '*' || c == ')');

	if ((wait == NUM && !wasnum)
		|| (wait == OP && !wasop)
		|| (c == ')' && !bracket))
		return ((unexpected(c)), 1);
//		return ((printf("char [%d:%c], wait err: ", c, c)), (unexpected(c)), 1);
	return (0);
//	return ((c == '(' && wait != NUM) || (c == ')' && wait != OP));
}

//what the hell we optimised out bracket tracking
node		*parse_expr(char **s, int bracket)
{
	node	*l = NULL;
	node	*curr = NULL;
	t_wait	wait = NUM;

//	printf("my bracket is %d\n", bracket);
	while (**s)
	{
		if (check_wait(wait, **s, bracket))
			return ((destroy_tree(l)), NULL);
		else if (accept(s, '('))
		{
//			curr = ((printf("enter bracket\n")), parse_expr(s, 1));
			curr = parse_expr(s, 1);
			if (!l && **s && **s != ')')
			{
				l = append_node(s, OP);
				if (!curr || !l)
					return ((destroy_tree(l)), (destroy_tree(curr)), NULL);
				l->l = curr;
				continue ;
			}
		}
		else if (accept(s, ')'))//refer to check_wait
		{
//			printf("exit bracket\n");
			bracket --;
			break ;
		}
		else
			curr = append_node(s, wait);
		if (!curr)
			break ;
		wait = !wait;//no bracket compensation
		if (increment(&l, &wait, curr, s))
			return ((destroy_tree(l)), NULL);
	}
	if (!curr || wait == NUM || bracket)
	{
		if (!**s)
		{
//			printf("main loop cause [curr %d, wait %d, bracket %d]: ", !curr, wait == NUM, bracket);
			unexpected(**s);
		}
		return ((destroy_tree(l)), NULL);
	}
//	printf("leave %d\n", bracket);
	return (l);
}

//no touch

int	eval_tree(node *tree)
{
	switch (tree->type)
	{
		case ADD:
			return (eval_tree(tree->l) + eval_tree(tree->r));
		case MULTI:
			return (eval_tree(tree->l) * eval_tree(tree->r));
		case VAL:
			return (tree->val);
	}
}
